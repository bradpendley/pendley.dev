---
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const field =
  'mt-2 block w-full rounded-lg border border-line-2 bg-ink px-3.5 py-2.5 text-sm text-paper placeholder:text-muted/60 transition-colors focus:border-cyan focus:outline-none focus-visible:outline-none focus:ring-2 focus:ring-cyan/30';
const label = 'font-mono text-[11px] uppercase tracking-widest text-muted';
---
<section id="contact" aria-labelledby="contact-title" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <SectionHeader id="contact-title" index="04" eyebrow="Contact" title="Let’s build something durable." />

    <div class="mt-12 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col gap-5">
        <!-- Email: copy-to-clipboard, falls back to mailto without JS -->
        <div class="rounded-2xl border border-line bg-ink-2/70 p-6 sm:p-7">
          <p class={label}>Email</p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <a href={`mailto:${site.email}`} class="font-mono text-base text-paper underline decoration-line-2 underline-offset-4 hover:decoration-cyan sm:text-lg">{site.email}</a>
          </div>
          <button type="button" data-copy={site.email}
            class="mt-5 inline-flex items-center gap-2 rounded-lg bg-paper px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-cyan">
            <span data-copy-idle class="inline-flex items-center gap-2"><Icon name="copy" size={15} /> Copy email</span>
            <span data-copy-done hidden class="inline-flex items-center gap-2"><Icon name="check" size={15} /> Copied</span>
          </button>
          <p data-copy-status class="sr-only" role="status" aria-live="polite"></p>
        </div>

        <!-- LinkedIn card -->
        <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer"
           class="group flex items-center gap-4 rounded-2xl border border-line bg-ink-2/70 p-6 transition-colors hover:border-cyan/60 sm:p-7">
          <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-[#0A66C2] text-white"><Icon name="linkedin" size={22} /></span>
          <span class="flex-1">
            <span class="block text-base font-semibold text-paper">{site.name}</span>
            <span class="block font-mono text-xs text-muted">linkedin.com/in/bradleypendley</span>
          </span>
          <Icon name="external" size={16} class="text-muted transition-colors group-hover:text-cyan" />
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>

      <!-- Contact form: works without JS (POST + redirect); JS upgrades to inline status. -->
      <form action={site.contactEndpoint} method="post" data-contact-form
            class="relative rounded-2xl border border-line bg-ink-2/70 p-6 sm:p-7">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="cf-name" class={label}>Name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" class={field} placeholder="Jane Smith" />
          </div>
          <div>
            <label for="cf-email" class={label}>Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" class={field} placeholder="jane@company.com" />
          </div>
        </div>
        <div class="mt-5">
          <label for="cf-message" class={label}>Message</label>
          <textarea id="cf-message" name="message" required rows="5" maxlength="5000" class={`${field} resize-y`} placeholder="What are you building?"></textarea>
        </div>
        <!-- Honeypot: hidden from people and assistive tech; bots fill it in. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="cf-company">Company</label>
          <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-cyan/60 bg-cyan/10 px-5 py-2.5 text-sm font-medium text-cyan transition-colors hover:bg-cyan hover:text-ink disabled:opacity-60">
            <Icon name="send" size={15} /> Send message
          </button>
          <p data-form-status role="status" aria-live="polite" class="font-mono text-xs text-muted"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // ~1 KB of progressive enhancement. Everything above works without it.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.copy ?? '';
    const status = document.querySelector('[data-copy-status]');
    try {
      await navigator.clipboard.writeText(email);
      btn.querySelector<HTMLElement>('[data-copy-idle]')!.hidden = true;
      btn.querySelector<HTMLElement>('[data-copy-done]')!.hidden = false;
      if (status) status.textContent = 'Email address copied to clipboard';
      setTimeout(() => {
        btn.querySelector<HTMLElement>('[data-copy-idle]')!.hidden = false;
        btn.querySelector<HTMLElement>('[data-copy-done]')!.hidden = true;
      }, 2000);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submit.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = '✓ Sent — I’ll reply soon.';
      status.className = 'font-mono text-xs text-emerald';
    } catch {
      status.textContent = 'Couldn’t send. Please email me directly.';
      status.className = 'font-mono text-xs text-amber';
    } finally {
      submit.disabled = false;
    }
  });

  // Non-JS fallback lands on /?sent=1#contact
  if (new URLSearchParams(location.search).get('sent') === '1') {
    const s = document.querySelector<HTMLElement>('[data-form-status]');
    if (s) { s.textContent = '✓ Sent — I’ll reply soon.'; s.className = 'font-mono text-xs text-emerald'; }
  }
</script>
