---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { projects, filters } from '../data/projects';

const counts = Object.fromEntries(
  filters.map((f) => [f.id, f.id === 'all' ? projects.length : projects.filter((p) => p.category.includes(f.id as never)).length]),
);
---
<section id="work" aria-labelledby="work-title" class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
  <SectionHeader id="work-title" index="01" eyebrow="Selected work" title="Engineering & Indie Apps">
    <!-- Filter: native radio group + CSS :has(). Arrow keys move between pills. -->
    <fieldset class="flex flex-wrap gap-2">
      <legend class="sr-only">Filter projects</legend>
      {filters.map((f, i) => (
        <label class="filter-pill inline-flex cursor-pointer select-none items-center gap-2 rounded-full border border-line-2 px-3.5 py-1.5 text-xs font-medium text-muted transition-colors hover:text-paper">
          <input type="radio" name="project-filter" id={`filter-${f.id}`} value={f.id} checked={i === 0} class="sr-only" />
          {f.label}
          <span class="font-mono text-[10px] opacity-70">{counts[f.id]}</span>
        </label>
      ))}
    </fieldset>
  </SectionHeader>

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</section>
