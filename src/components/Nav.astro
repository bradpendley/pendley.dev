---
import Icon from './Icon.astro';
import { site, isPlaceholder } from '../data/site';

const links = [
  { href: '#work', label: 'Work & Apps' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
const ext = 'noopener noreferrer';
---
<header class="sticky top-0 z-50 border-b border-line/80 bg-ink/75 backdrop-blur-md supports-[backdrop-filter]:bg-ink/60">
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#top" class="group flex items-center gap-3 font-mono text-sm" aria-label={`${site.domain} — back to top`}>
      <span class="text-paper">
        <span class="text-cyan">~/</span>{site.domain}<span class="ml-0.5 inline-block h-[1.05em] w-[0.55em] translate-y-[0.18em] bg-cyan motion-safe:animate-blink" aria-hidden="true"></span>
      </span>
      <span class="hidden items-center gap-2 rounded-full border border-line px-2.5 py-1 text-[11px] text-muted md:flex">
        <span class="size-1.5 rounded-full bg-emerald motion-safe:animate-pulse-dot" aria-hidden="true"></span>
        {site.location}
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {links.map((l) => (
          <li>
            <a href={l.href} class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-paper">{l.label}</a>
          </li>
        ))}
      </ul>
      <span class="mx-1 hidden h-5 w-px bg-line sm:block" aria-hidden="true"></span>
      {!isPlaceholder(site.links.github) && (
        <a href={site.links.github} target="_blank" rel={ext} class="grid size-10 place-items-center rounded-md text-muted transition-colors hover:text-paper" aria-label="GitHub (opens in new tab)">
          <Icon name="github" size={18} />
        </a>
      )}
      <a href={site.links.linkedin} target="_blank" rel={ext} class="grid size-10 place-items-center rounded-md text-muted transition-colors hover:text-paper" aria-label="LinkedIn (opens in new tab)">
        <Icon name="linkedin" size={17} />
      </a>
      <a href="#contact" class="ml-1 rounded-md border border-line-2 px-3 py-2 font-mono text-xs text-paper transition-colors hover:border-cyan hover:text-cyan sm:hidden">Contact</a>
    </div>
  </nav>
</header>
