---
import Icon from './Icon.astro';
import { site, isPlaceholder } from '../data/site';
const year = new Date().getFullYear();
const ext = 'noopener noreferrer';
const links = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'GitHub', href: site.links.github },
  { label: 'App Store', href: site.links.appStoreDeveloper },
].filter((l) => !isPlaceholder(l.href));
---
<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 sm:px-8 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1.5">
      <p class="text-sm text-paper">© {year} {site.name}</p>
      <p class="font-mono text-[11px] text-muted">Built with Astro &amp; Tailwind. Deployed on Cloudflare Edge.</p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel={ext} class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-paper">
            {l.label} <Icon name="external" size={12} class="opacity-60" /><span class="sr-only">(opens in new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
